PUBLIC_BASE_URL=http://localhost:8080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_ENCRYPTION_KEY=
# Optional upload cap in bytes. Unset means no limit (issue #36).
# MAX_UPLOAD_SIZE=
LOG_LEVEL=INFO
PORT=8080
# Publisher conversion: see docs/publisher-storage.md. Unset, .pub files can
# be checked but not converted.
PUBLISHER_BUCKET=
PUBLISHER_SIGNER=
# Optional TEMP_DIR must exist and be writable by the application.
