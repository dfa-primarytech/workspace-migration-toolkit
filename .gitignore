# Never commit real documents -- they may contain personal data
*.docx
*.doc
*.pptx
*.ppt
*.xlsx
*.xls
*.pub
*.pdf
# OpenDocument: a LibreOffice round-trip produces these, and a school
# migrating away from one suite often has both.
*.odt
*.ods
*.odp
# Still common in older school documents.
*.rtf
# The highest risk of the lot. A management-information export is a CSV, and
# the ones a school holds are pupil records.
*.csv
# Saved mail carries names and addresses in the headers alone.
*.eml
*.msg
samples/
# Synthetic test decks, each built by the script beside it with no real
# content. Listed one by one: a pattern here would let a real deck through.
!tests/fixtures/pptx/video-deck.pptx

# clasp
.clasp.json
.clasprc.json

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Local agent/session config
.claude/
# Platform build/test files and private runtime data
__pycache__/
*.pyc
*.egg-info/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
.env
.env.*
!.env.example
credentials*.json
*token*.json
job-output/

# Native parser build output
native/pub-parser/build/
.mcp.json
